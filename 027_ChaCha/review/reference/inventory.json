  "requirements": {
    "REQ-FUNC-001": {
      "statement": "The IP shall encrypt a message of 0 to 65535 data bytes with 0 to 65535 bytes of associated data using a 256-bit key and a 96-bit nonce, and shall output the ciphertext followed by a 16-byte tag exactly as AEAD_CHACHA20_POLY1305 of RFC 8439 section 2.8",
      "source": "RFC 8439 §2.8, DEC-003, DEC-015",
      "verification": "Simulation against RFC vectors and an independent model"
    },
    "REQ-FUNC-002": {
      "statement": "The IP shall decrypt a message and shall compare the computed tag with the 16 bytes that follow the ciphertext; on a mismatch it shall set the `tag_err` event and shall not set the `done` event, and on a match it shall set `done`",
      "source": "RFC 8439 §2.8, DEC-003",
      "verification": "Simulation with corrupted tag, ciphertext and associated data"
    },
    "REQ-FUNC-003": {
      "statement": "The IP shall derive the Poly1305 one-time key from the ChaCha20 block function with block counter 0 and shall encrypt the message data starting with block counter 1",
      "source": "RFC 8439 §2.6, §2.8",
      "verification": "Simulation against RFC vectors"
    },
    "REQ-FUNC-004": {
      "statement": "The ChaCha20 block function shall use 20 rounds, a 256-bit key, a 96-bit nonce and a 32-bit block counter, with the quarter round and state layout of the RFC",
      "source": "RFC 8439 §2.1 to §2.3",
      "verification": "Simulation against RFC vectors"
    },
    "REQ-FUNC-005": {
      "statement": "The IP shall compute Poly1305 over the associated data, padding to a multiple of 16 bytes with zero bytes, the ciphertext, padding to a multiple of 16 bytes, and the two 64-bit little-endian lengths in octets, using the clamped value r and the value s of the one-time key",
      "source": "RFC 8439 §2.5, §2.8",
      "verification": "Simulation against RFC vectors"
    },
    "REQ-FUNC-006": {
      "statement": "The IP shall treat the first `cha_len.aad_len` bytes of the input stream as associated data, the next `cha_len.msg_len` bytes as message data and, for a decryption, the next 16 bytes as the tag; it shall perform the padding of REQ-FUNC-005 itself",
      "source": "DEC-015, ASM-006, TBD-018, TBD-020",
      "verification": "Simulation with random lengths"
    },
    "REQ-FUNC-007": {
      "statement": "The IP shall take the 256-bit key only from the key-store port and shall provide no register or window from which software or the AXI4 interface can read the key or any part of the keystream state",
      "source": "DEC-006",
      "verification": "Inspection, register read test"
    },
    "REQ-FUNC-008": {
      "statement": "A write of one to `cha_ctrl.abort` while busy shall stop the message, empty the window FIFOs, clear busy and then clear the abort bit; no `done` or `tag_err` event shall be raised for the aborted message",
      "source": "DEC-008",
      "verification": "Simulation"
    },
    "REQ-FUNC-009": {
      "statement": "After a write of one to `cha_ctrl.start` with `cha_ctrl.en` set and the engine idle, the IP shall latch the message parameters, clear `cha_ctrl.start` and set `cha_sts.busy`; a start written while busy or with `cha_ctrl.en` clear shall be cleared by hardware without starting a message, so software confirms the acceptance by reading `cha_sts.busy` set",
      "source": "Section 11.2",
      "verification": "Simulation"
    },
    "REQ-FUNC-010": {
      "statement": "With `PARA_HOLD_EN` = 0 the IP shall release decrypted data to the output window as it is produced and report the tag result afterwards; with `PARA_HOLD_EN` = 1 it shall not release any decrypted data before the tag has been verified, and shall release none if the tag does not match",
      "source": "DEC-005",
      "verification": "Simulation"
    },
    "REQ-FUNC-011": {
      "statement": "With `PARA_NONCE_HW` = 0 the nonce shall come from `cha_nonce0` to `cha_nonce2` for every message",
      "source": "DEC-017",
      "verification": "Simulation"
    },
    "REQ-FUNC-012": {
      "statement": "With `PARA_NONCE_HW` = 1 the encryption nonce shall be the 32-bit `cha_salt.salt` as the upper part and the 64-bit counter of `cha_ctr_lo` and `cha_ctr_hi` as the lower part, the counter shall increase by one after each encrypted message, and a decryption shall use the nonce words of `cha_nonce0` to `cha_nonce2`",
      "source": "DEC-017",
      "verification": "Simulation"
    },
    "REQ-IF-001": {
      "statement": "The configuration interface shall be an APB4 slave generated from the workbook `VLSIT_CHACHA_CSR.xlsx`, with the access behavior of section 11.4",
      "source": "DEC-007, section 11",
      "verification": "Simulation, protocol checker"
    },
    "REQ-IF-002": {
      "statement": "The AXI4 data window shall accept INCR bursts of 1 to $\\min(256, 4096/(D/8))$ transfers inside one 4 KB region, ignore the address bits inside the window, send write data to the input FIFO and return read data from the output FIFO",
      "source": "DEC-014, Arm IHI 0022H.c §A3.4",
      "verification": "Protocol checker, simulation"
    },
    "REQ-IF-003": {
      "statement": "A FIXED or WRAP burst, or an INCR burst that crosses a 4 KB boundary, shall be answered with SLVERR (one `BRESP` for a write, every transfer for a read) and shall set the `axi_err` event",
      "source": "DEC-014, DEC-016",
      "verification": "Protocol checker, simulation"
    },
    "REQ-IF-004": {
      "statement": "A read of the output window that finds no data shall return SLVERR with zero read data for each transfer that cannot be served, shall complete the burst with the requested number of transfers and a correct RLAST, and shall set `axi_err`",
      "source": "DEC-016, Arm IHI 0022H.c \"Read and write response structure\"",
      "verification": "Protocol checker, simulation"
    },
    "REQ-IF-005": {
      "statement": "A write burst that exceeds the room of the input FIFO or the programmed message length shall return a single SLVERR on `BRESP`, drop the excess beats and set `axi_err`",
      "source": "DEC-016",
      "verification": "Protocol checker, simulation"
    },
    "REQ-IF-006": {
      "statement": "Each DMA request/acknowledge pair shall follow the four-phase handshake: request raised, acknowledge raised, request released, acknowledge released; a new request shall not be raised before the acknowledge is released; both signals are levels",
      "source": "DEC-010",
      "verification": "Assertions, simulation"
    },
    "REQ-IF-007": {
      "statement": "The write request shall be raised only when the input FIFO has room for the requested number of beats and the read request only when that many beats can be read; the number is $\\min(W, B_r)$ in tail mode 0 and one beat while $B_r < W$ in tail mode 1",
      "source": "DEC-013",
      "verification": "Assertions, simulation"
    },
    "REQ-IF-008": {
      "statement": "Both request outputs shall be low when `PARA_DMA_EN` = 0 or `cha_ctrl.dma_en` = 0",
      "source": "DEC-013",
      "verification": "Assertions, simulation"
    },
    "REQ-IF-009": {
      "statement": "The interrupt output shall be high while any bit of `cha_irq_sts` is set and low otherwise",
      "source": "DEC-007",
      "verification": "Simulation"
    },
    "REQ-IF-010": {
      "statement": "Under backpressure the IP shall not drop, duplicate or reorder a beat: a full input buffer shall lower the write-data ready, and the engine shall stall instead of overwriting a full output buffer or reading an empty input buffer",
      "source": "Section 10.4",
      "verification": "Simulation with a scoreboard, assertions"
    },
    "REQ-CLK-001": {
      "statement": "The IP shall have the clock inputs `i_clk_apb`, `i_clk_axi` and `i_clk_core`; with `PARA_SYNC_AXI_CORE` = 1 or `PARA_SYNC_APB_CORE` = 1 the corresponding crossing logic shall be absent, and with 0 every crossing of section 7.2 shall use the stated structure",
      "source": "DEC-011",
      "verification": "CDC lint, simulation"
    },
    "REQ-CLK-002": {
      "statement": "No signal shall cross between clock domains without the structure listed in section 7.2",
      "source": "Section 7.2",
      "verification": "CDC lint, inspection"
    },
    "REQ-RESET-001": {
      "statement": "Each domain shall have an active-low reset with asynchronous assertion and release synchronized to its clock; after reset both DMA request outputs shall be low, the AXI4 ready and valid outputs shall be low and the engine shall be idle",
      "source": "Section 7.3",
      "verification": "Reset test, assertions"
    },
    "REQ-RESET-002": {
      "statement": "After reset the key-dependent state and the registers of the engine shall be cleared and `cha_sts.ctr_vld` shall be 0",
      "source": "Section 7.3, TBD-017",
      "verification": "Reset test"
    },
    "REQ-REG-001": {
      "statement": "The register at offset 0x0 shall be `cha_version` with major 1 and minor 0",
      "source": "Rule R-067, DEC-001",
      "verification": "Register test"
    },
    "REQ-REG-002": {
      "statement": "Every register shall follow the access type and the reset value of the workbook `VLSIT_CHACHA_CSR.xlsx`",
      "source": "Section 11.1",
      "verification": "Register test"
    },
    "REQ-REG-003": {
      "statement": "The registers `cha_irq_en`, `cha_irq_inj` and `cha_irq_sts` shall have the same fields at the same bits as `cha_irq_raw`; an injection rising edge shall raise the raw event",
      "source": "Rule R-040",
      "verification": "Register test"
    },
    "REQ-PARAM-001": {
      "statement": "The elaboration shall stop with an error for: `PARA_RND_CYC` = 2 with `PARA_QR_NUM` not 4, `PARA_AXI_DW` not a multiple of 32, a FIFO depth that is not a power of two, and `PARA_HOLD_EN` = 1 with an output capacity smaller than `PARA_MSG_MAX_B`",
      "source": "Section 8",
      "verification": "Elaboration test"
    },
    "REQ-PARAM-002": {
      "statement": "The configurations CFG-LP, CFG-BASE and CFG-HP shall elaborate and pass lint",
      "source": "Section 8",
      "verification": "Lint, elaboration"
    },
    "REQ-PARAM-003": {
      "statement": "A watermark above the maximum of section 8 shall set `len_err` and the message shall not start",
      "source": "Section 8, DEC-013",
      "verification": "Simulation"
    },
    "REQ-ERR-001": {
      "statement": "A `cha_len.msg_len` above `PARA_MSG_MAX_B` shall set `len_err` and the message shall not start",
      "source": "DEC-015, section 8",
      "verification": "Simulation"
    },
    "REQ-ERR-002": {
      "statement": "An encryption started with `PARA_NONCE_HW` = 1 while `cha_sts.ctr_vld` is 0, or with a counter that would wrap, shall not start and shall set `ctr_err`",
      "source": "DEC-017, TBD-019",
      "verification": "Simulation"
    },
    "REQ-PERF-001": {
      "statement": "The ChaCha20 core should produce one 64-byte block in the number of cycles of the table of section 8 plus a small fixed overhead, for each setting of `PARA_QR_NUM`, `PARA_RND_CYC` and `PARA_CORE_NUM`",
      "source": "Section 8, TBD-001",
      "verification": "Cycle-accurate simulation against the model"
    },
    "REQ-SEC-001": {
      "statement": "In the software-nonce build the nonce shall never be generated inside the IP, and in the hardware nonce build the counter value used for one encryption shall never be used again with the same salt until software loads a new start value",
      "source": "RFC 8439 §2.6, DEC-017",
      "verification": "Simulation, assertion"
    },
    "REQ-SEC-002": {
      "statement": "The 16-byte tag comparison of a decryption should take the same number of cycles whatever the position of the first differing byte",
      "source": "Author's proposal, TBD-005",
      "verification": "Simulation, inspection"
    },
    "REQ-SEC-003": {
      "statement": "The key-store port shall be sampled only while the engine latches the key for a message and no copy of the key shall be visible at an output other than the cipher core",
      "source": "DEC-006, TBD-009",
      "verification": "Inspection"
    },
    "REQ-SEC-004": {
      "statement": "The key register and the ChaCha20 and Poly1305 state shall be cleared at the end of every message, on an abort and on reset, and a rejected plaintext in hold mode shall be discarded",
      "source": "Section 10.1, section 18",
      "verification": "Simulation, inspection"
    }
  },
