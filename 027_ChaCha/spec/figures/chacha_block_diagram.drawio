        <mxCell id="i1__r1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__t" vlsit_native_table="1">
          <mxGeometry y="76" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i1__r1__c0" value="TOP (m_chacha_top) frame" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r1" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r1__c1" value="Structural top of the ChaCha20-Poly1305 IP. It holds no logic of its own and instantiates the register block, the data window, the window storage, the DMA request logic, the cipher engine and the interrupt logic. The configuration interface is on the right, the data window is on the left, and the DMA channels, the key-store port, the test enable and the three clock and reset pairs are the other boundary interfaces." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r1__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r1__c3" value="AXI, APB, INT, DMAW, DMAR, KEYQ, KEY, TEST, CKAXI, CKCOR, CKAPB" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__t" vlsit_native_table="1">
          <mxGeometry y="156" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i1__r2__c0" value="u_axi_win (m_chacha_axi_win)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r2__c1" value="Data window of the AXI4 subordinate interface. It accepts incrementing bursts into the input window and serves incrementing read bursts from the output window, ignores the address bits inside the window, and answers every unsupported burst, every overrun, every underrun and every non-secure access with the protection check on with a subordinate error while still completing the burst. It counts the beats against the programmed message length." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r2__c2" value="Section 6.3, DEC-014, DEC-016" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r2__c3" value="WIN, ERRF, AXI, CKAXI" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r2" vlsit_native_table="1">
