        <mxCell id="i1__r5__c1" value="Register block generated from the register workbook. It decodes the peripheral bus accesses, holds the configuration fields, the nonce and counter fields, the interrupt registers and the capability constants, and crosses between the configuration clock and the core clock when they are different." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r5" vlsit_native_table="1">
