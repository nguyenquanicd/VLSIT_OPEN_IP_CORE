          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r3__c1" value="Window storage. It holds the input window, which buffers the associated data, the message data and for a decryption the tag, and the output window, which buffers the ciphertext or plaintext and the tag, between the bus clock and the core clock. Each window becomes a synchronous buffer when its two clocks are the same net. It reports the free room of the input window and the data held in the output window for the DMA request logic, and in the hold setting keeps decrypted data back until the tag is verified." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r3__c2" value="Section 7.2, CDC-003, CDC-004, DEC-005" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r3" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
