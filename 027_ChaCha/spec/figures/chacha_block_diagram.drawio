            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i1__r4__c1" value="Cipher engine. It requests the key from the key store, latches it, derives the one-time authentication key, generates the keystream, encrypts or decrypts the message data, authenticates the associated data and the ciphertext, builds and checks the tag, handles the nonce and the message sequence, and raises the completion and error events. Its datapath is gated while it is idle." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r4" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
