<mxfile host="app.diagrams.net">
  <diagram name="ChaCha20-Poly1305 engine (documented vs inferred)" id="chacha-arch">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Generic ChaCha20-Poly1305 AEAD engine, as drawn in vendor sheets D1, D3, D4 (English labels; solid = documented, dashed = inferred or unknown)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="Host / SoC bus master&#xa;(AMBA AHB or AXI per D1, D4; AXI4-Stream plus APB per D2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bridge" value="Core interface bridge&#xa;AMBA, SRAM, FIFO, DMA&#xa;(D1, D4; scatter/gather DMA optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="infifo" value="Input FIFO&#xa;(D3 only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl" value="Control&#xa;AEAD, encryption, authentication modes&#xa;(D1, D4); commands/responses, key, nonce, tag ports (D3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cc" value="ChaCha20 engine&#xa;(D3: parallel ChaCha20 cores;&#xa;D4: unit scales with throughput)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="poly" value="Poly1305 engine&#xa;(D3: pipelined; D4: high-throughput variant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="outfifo" value="Output FIFO&#xa;(D3 only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="330" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="otk" value="Poly1305 one-time key taken from the ChaCha20 keystream (D1 'key generation for Poly1305: ChaCha20 / dedicated input', D4 'key generation by ChaCha20')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="unk" value="UNKNOWN in all sampled sheets: clock/reset scheme, power domains, memory interface depth, error and tag-failure reporting, register map, per-message latency, safety diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Legend: green = block named in a sheet; yellow dashed = inferred relationship from sheet wording; red dashed = unknown. Data-flow arrows between blocks are inferred except where a sheet draws them (D1, D3, D4 block drawings show the bridge, engines and control)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1000" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;" edge="1" parent="1" source="host" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="bridge" target="infifo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;" edge="1" parent="1" source="bridge" target="ctrl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="infifo" target="cc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;" edge="1" parent="1" source="ctrl" target="cc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;" edge="1" parent="1" source="ctrl" target="poly"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="cc" target="poly"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="poly" target="outfifo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=1;dashed=1;" edge="1" parent="1" source="ctrl" target="otk"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
