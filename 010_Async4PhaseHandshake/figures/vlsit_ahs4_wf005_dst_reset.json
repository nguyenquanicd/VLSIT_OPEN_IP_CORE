 "head": {
  "text": "WF-005: illegal destination-only reset while the source keeps running"
 },
 "foot": {
  "text": "Destination-only reset is outside the contract. o_req and o_data clear in the destination domain, but the source holds reg_req high with o_ack low because no acknowledge was returned. The defined recovery is i_rst_n_src."
 }
