        <mxCell id="i1__r1__c1" value="Structural top of the APB I2S controller. It holds no logic: it instantiates the register block, the FIFOs, the serial engines and the support blocks. The APB domain is on the left, the serial domain on the right." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i1__r1" vlsit_native_table="1">
