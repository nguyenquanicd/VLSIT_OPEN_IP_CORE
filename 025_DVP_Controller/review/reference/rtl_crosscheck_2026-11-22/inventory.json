  "requirements": {
    "REQ-FUNC-001": {
      "statement": "Each elaborated configuration shall select one supported DVP data width of 8, 10, or 12 bits using compile-time configuration.",
      "source": "User answer 2026-11-21; sensor research corpus",
      "verification": "Elaboration check and profile-specific simulation"
    },
    "REQ-FUNC-002": {
      "statement": "Each elaborated configuration shall use compile-time-selected data width, PCLK sampling edge, and VSYNC/HREF active polarity; these profile settings shall not change at runtime.",
      "source": "User answer 2026-11-21/22",
      "verification": "Parameter sweep, elaboration, and capture simulation"
    },
    "REQ-FUNC-003": {
      "statement": "The capture path shall preserve FIFO ordering. When full, it shall drop the newest sample, preserve unread entries, and set sticky W1C overflow status; a new event wins over a simultaneous clear.",
      "source": "User decision 2026-11-22; DEC-010, DEC-023",
      "verification": "Overflow/full boundary test; verify no overwrite and set-dominant clear"
    },
    "REQ-PARAM-001": {
      "statement": "PARA_FIFO_DEPTH shall be a power of two, minimum 2, default 8, and apply to both mode-specific FIFOs.",
      "source": "User decision 2026-11-22; AFIFO implementation",
      "verification": "Parameter legality and depth-boundary elaboration"
    },
    "REQ-IF-001": {
      "statement": "The controller shall expose one APB4 interface for control/status and system-DMA sample reads. One successful read from the sample-data endpoint shall return exactly one DVP sample and consume exactly one FIFO entry.",
      "source": "User answer 2026-11-21; REF-001",
      "verification": "APB protocol simulation and FIFO data-order scoreboard"
    },
    "REQ-IF-002": {
      "statement": "For a read of the sample-data endpoint, the Completer shall hold PREADY LOW while the FIFO is empty and the configured timeout has not expired. It shall pop exactly one entry only when the APB read completes successfully.",
      "source": "User answer 2026-11-21; REF-001 sections 3.1 and 3.4",
      "verification": "Empty-to-nonempty completion and timed-out read simulations; no pop on error"
    },
    "REQ-IF-003": {
      "statement": "The top-level DVP inputs shall be PCLK, parameter-width data, VSYNC, and HREF; VSYNC marks frame start, HREF is a level qualifier, and no independent HSYNC or embedded-code parser is required. In continuous mode, active VSYNC shall overlap at least one selected PCLK edge. In gated mode, each selected PCLK sample edge while HREF is active denotes one valid pixel, and the sensor shall provide no PCLK edge during active VSYNC or during an HREF-high gap with no valid pixel.",
      "source": "User decision 2026-11-22",
      "verification": "Port/profile checks and mode-specific capture waveform"
    },
    "REQ-IF-004": {
      "statement": "The controller shall assert o_dma_req when occupancy of the selected FIFO reaches the programmed nonzero watermark; zero keeps request low. The request remains asserted until a one-cycle i_dma_ack pulse in CLK-APB. After acknowledgement, re-arm only after selected occupancy falls below the watermark and later reaches it again. AFIFO occupancy may lag writes by CDC latency; SFIFO occupancy is counted exactly in CLK-APB. Payload moves only through successful APB FIFO_DATA reads.",
      "source": "User answers 2026-11-21/22; DEC-008, DEC-012, DEC-022",
      "verification": "Watermark crossing/ACK/re-arm in both modes"
    },
    "REQ-IF-005": {
      "statement": "The software-programmed empty-read timeout shall count CLK-APB cycles during an active FIFO-data read access that finds the FIFO empty. If the configured timeout is zero and the FIFO is empty in the first APB access cycle, the transfer shall immediately complete with PREADY=1 and PSLVERR=1, and shall not pop the FIFO. For a positive timeout, if the FIFO remains empty through the configured number of APB access cycles, the transfer shall complete with PREADY=1 and PSLVERR=1 only in the final APB cycle, and shall not pop the FIFO. If a sample is available at the completion decision, the successful read shall take priority and pop exactly one entry.",
      "source": "User answer 2026-11-21; REF-001 section 3.4",
      "verification": "Threshold-boundary tests for arrival before, at, and after expiration; check final-cycle PSLVERR and pop count"
    },
    "REQ-REG-001": {
      "statement": "Software shall use the APB4 interface to configure capture operation and inspect controller status; the CSR workbook shall define all software-visible fields and reset values.",
      "source": "User answer 2026-11-21; REF-001",
      "verification": "Workbook validation, generated-port review, and APB simulation"
    },
    "REQ-SCOPE-001": {
      "statement": "Camera configuration and auxiliary sensor board controls shall remain outside this IP; the controller shall perform DVP capture only.",
      "source": "User answer 2026-11-21",
      "verification": "Architecture and port inspection"
    },
    "REQ-FUNC-004": {
      "statement": "`dvp_ctrl.pclk_mode` shall select continuous mode (0, reset) or gated-valid-pixel mode (1). The mode bit shall update only when capture is disabled, both mode FIFOs are empty, and the current capture source is quiescent (continuous mode: PCLK capture-disable acknowledgement after the registered AFIFO write pulse drains; gated mode: the synchronized pixel toggle has no pending event). If capture is enabled, the same write sets CAPTURE_EN, either FIFO is nonempty, or the source is not quiescent, the mode bit shall retain its prior value while the APB write completes with OKAY. Software shall read back the field to confirm an accepted mode change.",
      "source": "User decision 2026-11-22; DEC-018, DEC-028",
      "verification": "Mode-lock, nonempty-FIFO and source-quiescence checks"
    },
    "REQ-FUNC-005": {
      "statement": "Continuous mode shall sample each selected PCLK edge when capture is enabled, a frame has been observed, and HREF is active; each accepted sample shall write once to the DVP-local AFIFO.",
      "source": "User decision 2026-11-22; DEC-018",
      "verification": "PCLK-edge and AFIFO data-order waveform/test"
    },
    "REQ-FUNC-006": {
      "statement": "Gated mode shall synchronize VSYNC through two CLK-APB stages and detect its active edge. For each selected PCLK sample edge while HREF is active, the source shall register the pixel and toggle valid once; CLK-APB shall synchronize the toggle through two stages, detect either transition, and enqueue the held sample only when capture is enabled and the APB frame state is active. Toggle tracking continues while capture is disabled so enabling cannot replay a stale event.",
      "source": "User decision 2026-11-22; DEC-020..DEC-024",
      "verification": "Toggle both-edge, capture/frame qualification and bundled-data checks"
    },
    "REQ-FUNC-007": {
      "statement": "Gated mode shall require a VSYNC active pulse of at least four CLK-APB cycles and at least four CLK-APB cycles between successive accepted PCLK sample edges; the synchronized VSYNC frame-start state shall be established before the first valid pixel event is enqueued. The pixel-spacing limit gives the 2-FF/toggle-detect/FIFO-write path time to consume the held sample.",
      "source": "User decision 2026-11-22; DEC-021, DEC-024",
      "verification": "Waveform and integration timing constraint check"
    },
    "REQ-FUNC-008": {
      "statement": "Each FIFO_DATA read shall return one unsigned sample zero-extended to 32 bits, with the sample in the least-significant bits and upper bits zero.",
      "source": "User decision 2026-11-21; DEC-014",
      "verification": "Width-specific read-data checks"
    },
    "REQ-IF-006": {
      "statement": "FIFO_DATA byte address shall be PARA_FIFO_DATA_ADDR, default 16'h0100; PARA_FIFO_DATA_ADDR shall be word-aligned and not overlap the CSR map. Decode the four-byte word using PADDR[15:2]; only the aligned base address is valid. Aligned reads pop once on successful completion, writes and misaligned accesses within that word return PSLVERR without pop.",
      "source": "User decision 2026-11-21; DEC-016",
      "verification": "Decode/alignment/write-error checks"
    },
    "REQ-PERF-001": {
      "statement": "In gated mode, the minimum interval between accepted PCLK sample edges shall satisfy $T_{PIX,min} \\ge 4T_{APB}+T_{margin}$, where $T_{margin}$ includes bundled-data setup/hold and clock uncertainty; equivalently, nominal $f_{APB} \\ge 4f_{PIX,max}$. This limit applies to peak active-pixel spacing, not frame-average rate.",
      "source": "User decision 2026-11-22; DEC-021, DEC-024",
      "verification": "Waveform and STA/SDC review"
    },
    "REQ-RESET-001": {
      "statement": "A common active-low reset shall assert asynchronously. APB and continuous-mode PCLK logic use local asynchronous-assert/synchronous-release resets. Gated-mode held-data/toggle launch registers use the APB-local reset because PCLK may be stopped; software shall enable capture only after reset release and before a subsequent active VSYNC pulse that lasts at least four APB cycles before the first pixel. Reset leaves capture disabled, both FIFOs empty, DMA request low, and a pending FIFO_DATA transfer cancelled without completion or pop.",
      "source": "User answer 2026-11-21/22; DEC-012, DEC-017, DEC-029",
      "verification": "Reset, gated-PCLK first-pixel and pending-read-abort checks"
    }
  },
