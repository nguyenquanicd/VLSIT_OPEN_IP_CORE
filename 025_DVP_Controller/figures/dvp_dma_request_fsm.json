    {
      "src": "ENUM_ST_REQ_PENDING",
      "dst": "ENUM_ST_SERVICE_ACTIVE",
      "label": "dma_ack pulse"
    },
    {
      "src": "ENUM_ST_SERVICE_ACTIVE",
      "dst": "ENUM_ST_WAIT_WATERMARK",
      "label": "occupancy < watermark"
    }
  ],
  "layout": {
    "margin": 50
  }
