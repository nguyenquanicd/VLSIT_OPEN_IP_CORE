plugin -i slang
read_slang -f ../synth/fl_utmi_axim.f --top m_usb2_top_utmi_axim -G PARA_USB2_ROLE=1 -G PARA_USB2_NUM_EP=1 -G PARA_USB2_NUM_HC=8 -G PARA_USB2_UTMI_W=16 -G PARA_USB2_AXI_DATA_W=64 -G PARA_USB2_SPLIT_EN=1 -G PARA_USB2_FIFO_DEPTH=1024 -D VLSIT_SYNTHESIS
hierarchy -top m_usb2_top_utmi_axim
synth -top m_usb2_top_utmi_axim -flatten
dfflibmap -liberty ../synth/pdk_freepdk45/gscl45nm.lib
abc -liberty ../synth/pdk_freepdk45/gscl45nm.lib -D 6667 -script +strash;&get,-n;&fraig,-x;&put;scorr;dc2;strash;&get,-n;&dch,-f;&nf,{D};&put;buffer;upsize,{D};dnsize,{D};topo;stime,-p
opt_clean
tee -o ../synth/asic_TOP-HOST-OPT0_stat.txt stat -liberty ../synth/pdk_freepdk45/gscl45nm.lib
