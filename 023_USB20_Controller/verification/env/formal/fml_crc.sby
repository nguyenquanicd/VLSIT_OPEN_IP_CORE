[tasks]
crc5_w11
crc5_w19
crc16_b1
crc16_b2
cov5
cov16

[options]
crc5_w11: mode bmc
crc5_w19: mode bmc
crc16_b1: mode bmc
crc16_b2: mode bmc
cov5: mode cover
cov16: mode cover
depth 1

[engines]
smtbmc z3

[script]
plugin -i slang
crc5_w11: read_slang --top fml_crc -G W=11 -G BYTES=1 -G SEL=0 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
crc5_w19: read_slang --top fml_crc -G W=19 -G BYTES=1 -G SEL=0 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
crc16_b1: read_slang --top fml_crc -G W=11 -G BYTES=1 -G SEL=1 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
crc16_b2: read_slang --top fml_crc -G W=11 -G BYTES=2 -G SEL=1 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
cov5: read_slang --top fml_crc -G W=11 -G BYTES=1 -G SEL=0 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
cov16: read_slang --top fml_crc -G W=11 -G BYTES=2 -G SEL=1 fml_crc.sv m_usb2_crc5.sv m_usb2_crc16.sv
prep -top fml_crc

[files]
fml_crc.sv
../../../rtl/m_usb2_crc5.sv
../../../rtl/m_usb2_crc16.sv
