<mxfile host="app.diagrams.net">
  <diagram name="Signature engine (composite)" id="sig1">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Composite signature engine - blocks named in D2, D3, D5, D7, D8, D9 (not any single product). Solid = documented, dashed = inferred or proposal, ? = unknown." style="text;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="host" value="SoC CPU / DMA&#xa;(D7 p.1, D8 p.1)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="bus" value="Host port&#xa;AMBA APB/AHB/AXI (D7, D8) or 16/64-bit custom port (D2, D3, D5)&#xa;register map: ?" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="260" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="ctl" value="Control / sequencer&#xa;commands, responses, busy (D2 p.2, D3 p.3)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="rom" value="Program / constant ROM&#xa;(D5 p.3, D9 p.1, D3 p.2)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="alu" value="Arithmetic datapath&#xa;EC field arithmetic / ALU (D2, D5, D9) or NTT + polynomial unit (D3)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="ram" value="Dual-port / multi-port RAM&#xa;(D2 p.2, D5 p.3, D3 p.2, D7 p.1)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="key" value="Secret-key store interface&#xa;sks_* port (D2 p.2); wipe behaviour: ?" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="410" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="hash" value="Hash: SHA-3/SHAKE inside ML-DSA core (D3 p.2);&#xa;external hash for ECDSA (D5 p.2); SHA-512 for Ed25519: not stated in the briefs" style="rounded=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="rng" value="RNG / TRNG&#xa;external (D5 p.2, D8 p.1)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="sca" value="Side-channel countermeasures&#xa;constant time (D2, D5, D3, D9); DPA (D7, D8)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="flt" value="Fault check (verify-after-sign / redundancy)&#xa;NOT documented in any product: proposal A only" style="rounded=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=classic;" edge="1" parent="1" source="host" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;" edge="1" parent="1" source="bus" target="ctl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;" edge="1" parent="1" source="rom" target="ctl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;" edge="1" parent="1" source="ctl" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;startArrow=classic;" edge="1" parent="1" source="alu" target="ram"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;" edge="1" parent="1" source="key" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;dashed=1;" edge="1" parent="1" source="hash" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=classic;dashed=1;" edge="1" parent="1" source="rng" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=none;dashed=1;" edge="1" parent="1" source="sca" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=none;dashed=1;" edge="1" parent="1" source="flt" target="alu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lg" value="Legend: green = documented datapath/control; blue = host interface; yellow = external or inferred dependency; red = security measure (dashed = not documented). Connections between blocks other than host-port to controller are inferred from block diagrams without signal-level detail." style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1040" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
